---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';

// Turnstile site key. Local dev uses Cloudflare's always-pass test key (the real key only works on the site's hostnames).
const turnstileSiteKey = import.meta.env.DEV ? '1x00000000000000000000AA' : site.turnstileSiteKey;

const topics = [
  { value: 'subscribe', label: 'Subscribing a student' },
  { value: 'levels', label: 'Pricing for more than one level' },
  { value: 'school', label: 'A package for my Marathi shala' },
  { value: 'support', label: 'Help with my account' },
  { value: 'other', label: 'Something else' },
];
---

<Base title="Contact us" description="Questions about Barakhadi, subscribing a student or a package for your Marathi shala? Send us a message.">
  <PageHeader tone="blue" title="Get in touch" intro="Questions, subscriptions or a package for your Marathi shala: we're happy to help." />

  <section class="section">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <div class="grid content-start gap-6">
        <div class="info">
          <h2 class="text-xl">Email us</h2>
          <p class="mt-1 text-ink-soft">Write to us directly at</p>
          <p class="mt-1 text-lg font-bold select-all">{site.email}</p>
        </div>
        <div class="info">
          <h2 class="text-xl">Marathi shalas</h2>
          <p class="mt-1 text-ink-soft">Tell us how many students and teachers you have and which levels you teach, and we'll suggest a package.</p>
        </div>
        <div class="info">
          <h2 class="text-xl">Already a student?</h2>
          <p class="mt-1 text-ink-soft">Log in to your activities from the <strong>Log in</strong> button at the top of the page.</p>
        </div>
      </div>

      <form id="contact-form" class="form" method="post" action="/api/contact/" novalidate>
        <h2 class="text-2xl">Send us a message</h2>

        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="phone">Phone <span class="opt">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
          </div>
          <div class="field">
            <label for="location">City, country <span class="opt">(optional)</span></label>
            <input id="location" name="location" type="text" autocomplete="address-level2" maxlength="100" placeholder="e.g. Pune, India" />
          </div>
        </div>
        <div class="field">
          <label for="topic">What is it about?</label>
          <select id="topic" name="topic" required>
            <option value="" disabled selected>Choose a topic</option>
            {topics.map((t) => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
        </div>
        <!-- Honeypot: hidden from people, bots fill it in -->
        <div class="hp" aria-hidden="true">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>

        <button type="submit" class="btn btn-primary w-full sm:w-auto">Send message</button>
        <p id="form-status" class="status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  // Preselect the topic from links like /contact-us/?topic=school
  const params = new URLSearchParams(location.search);
  const topic = params.get('topic');
  const select = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const showStatus = (text: string, ok: boolean) => {
    if (!status) return;
    status.textContent = text;
    status.dataset.state = ok ? 'ok' : 'error';
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const chosenTopic = String(data.get('topic') ?? '');
    if (!name || !email || !chosenTopic || !message) return showStatus('Please fill in your name, email, topic and message.', false);
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showStatus('That email address doesn\'t look right. Please check it.', false);

    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && body.ok) {
        form.reset();
        // @ts-expect-error turnstile is a global from the Cloudflare script
        window.turnstile?.reset();
        showStatus("Thanks! Your message is on its way. We'll reply by email.", true);
      } else {
        showStatus(body.error ?? 'Something went wrong sending your message. Please email us instead.', false);
      }
    } catch {
      showStatus('Your message could not be sent. Check your connection, or email us instead.', false);
    } finally {
      button.disabled = false;
      button.textContent = 'Send message';
    }
  });
</script>

<style>
  .info { padding: 1.5rem; border-radius: var(--radius-card); background: var(--color-mist); }
  .form {
    display: grid;
    gap: 1.2rem;
    padding: 2rem;
    border: 3px solid var(--color-blue);
    border-radius: 1.5rem;
    background: #fff;
  }
  .field { display: grid; gap: 0.4rem; }
  .field-row { display: grid; gap: 1.2rem; }
  @media (min-width: 640px) { .field-row { grid-template-columns: 1fr 1fr; } }
  .opt { font-weight: 600; color: var(--color-ink-soft); }
  label { font-weight: 800; }
  input, select, textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2px solid #cfd6cc;
    border-radius: 0.8rem;
    background: #fff;
    font: inherit;
    color: inherit;
  }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--color-orange); outline-offset: 1px; border-color: var(--color-green); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .status { font-weight: 700; }
  .status[data-state='ok'] { color: var(--color-green-ink); }
  .status[data-state='error'] { color: var(--color-red-ink); }
  button[disabled] { opacity: 0.7; cursor: progress; }
</style>
