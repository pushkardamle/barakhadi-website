---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import WistiaVideo from '@/components/WistiaVideo.astro';
import { freeActivities, levels, site, videos } from '@/data/site';
// Different screenshots from the hero, so no image repeats on the home page.
import conversationShot from '@/assets/activities/ss_snow_result.avif';
import readingShot from '@/assets/activities/ss_word_search_result.avif';
import writingShot from '@/assets/activities/ss_numbers_trace_result.avif';

const badges = [
  { value: site.activityCount, label: 'Activities', detail: 'Reading, writing and speaking practice', tone: 'orange' },
  { value: '3', label: 'Levels', detail: levels.map((l) => l.marathi).join(' · '), tone: 'green', marathi: true },
  { value: 'Any', label: 'Device', detail: 'Computer, tablet or phone', tone: 'blue' },
  { value: 'Self', label: 'Paced', detail: 'Learn on your own schedule', tone: 'red' },
];

const skills = [
  {
    title: 'Conversation',
    text: `Practice real-world dialogues across ${site.conversationTopics} kid-friendly topics, from introducing yourself to talking about your day. Kids listen, repeat and build the confidence to speak.`,
    image: conversationShot,
    alt: 'Conversation activity: two children at a window at night, with a play button to hear the dialogue',
    activity: freeActivities[0],
  },
  {
    title: 'Reading',
    text: 'Learn the Marathi alphabet and build reading fluency. Activities move from letters to words to full sentences, with audio for every word.',
    image: readingShot,
    alt: 'Reading activity: a Marathi word search with clue words',
    activity: freeActivities[1],
  },
  {
    title: 'Writing',
    text: 'Write Devanagari letters, numbers and words with step-by-step tracing. Kids can repeat every exercise as often as they like.',
    image: writingShot,
    alt: 'Writing activity: tracing Marathi numerals with coloured pencils',
    activity: freeActivities[2],
  },
];

const benefits = [
  {
    title: 'Learning feels like play',
    text: 'Games, puzzles and stories keep kids engaged, so practice never feels like homework.',
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-3.5-7.5s1.3 2 3.5 2 3.5-2 3.5-2M9 9.5h.01M15 9.5h.01',
  },
  {
    title: 'Learn anywhere',
    text: 'At home, in class or on the go. Every activity works on a computer, tablet or phone.',
    icon: 'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4 15h2',
  },
  {
    title: 'Practice until it sticks',
    text: 'Repeat any activity as many times as you like to build fluency and long-term memory.',
    icon: 'M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4',
  },
];

const activityTones = ['green', 'blue', 'red'];
---

<Base>
  <Hero />

  <!-- What is Barakhadi -->
  <section class="section" aria-labelledby="what-title">
    <div class="container-site text-center">
      <h2 id="what-title" class="h-section mx-auto max-w-3xl">The modern way to learn and practice Marathi</h2>
      <p class="lede mx-auto mt-5 max-w-2xl">
        Over 300 interactive activities that make learning Marathi feel like play. Made by experienced Marathi teachers for kids, families and Marathi schools.
      </p>
      <ul class="badges">
        {badges.map((b) => (
          <li class={`badge badge-${b.tone}`}>
            <span class="badge-value">{b.value}</span>
            <span class="badge-label">{b.label}</span>
            <span class="badge-detail" lang={b.marathi ? 'mr' : undefined}>{b.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Three skills -->
  <section class="section bg-mist" aria-labelledby="skills-title">
    <div class="container-site">
      <div class="text-center">
        <h2 id="skills-title" class="h-section">Speak, read and write Marathi</h2>
      </div>
      <div class="mt-20 grid gap-16 md:mt-24 md:gap-24">
        {skills.map((s, i) => (
          <article class:list={['skill', { reverse: i % 2 === 1 }]}>
            <div class="skill-text">
              <span class="skill-num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a href={s.activity.url} class="btn btn-primary" target="_blank" rel="noopener">
                Try a free {s.title.toLowerCase()} activity
                <span aria-hidden="true">→</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
            <div class="skill-shot">
              <Image src={s.image} alt={s.alt} widths={[480, 720, 1080]} sizes="(min-width: 968px) 540px, 100vw" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section bg-cream" aria-labelledby="benefits-title">
    <div class="container-site">
      <h2 id="benefits-title" class="h-section text-center">Why families choose Barakhadi</h2>
      <ul class="mt-16 grid gap-10 md:mt-20 md:grid-cols-3">
        {benefits.map((b) => (
          <li class="text-center">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={b.icon} /></svg>
            </span>
            <h3 class="mt-5 text-2xl">{b.title}</h3>
            <p class="mx-auto mt-2 max-w-xs text-ink-soft">{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Try it free -->
  <section id="try-free" class="section scroll-mt-32" aria-labelledby="try-title">
    <div class="container-site">
      <div class="text-center">
        <h2 id="try-title" class="h-section">Try it yourself</h2>
        <p class="lede mx-auto mt-4 max-w-xl">Pick an activity and start in seconds. Each one opens in a new tab.</p>
      </div>
      <ul class="mt-16 grid gap-7 md:mt-20 md:grid-cols-3">
        {freeActivities.map((a, i) => (
          <li class="activity-card">
            <div class={`activity-thumb tone-${activityTones[i]}`} aria-hidden="true"><span lang="mr">{a.glyph}</span></div>
            <div class="grid flex-1 content-start gap-2 p-6">
              <p class="text-sm font-extrabold uppercase tracking-widest text-ink-soft">{a.title}</p>
              <h3 class="text-2xl">{a.subtitle}</h3>
              <p class="text-ink-soft">{a.description}</p>
            </div>
            <div class="px-6 pb-6">
              <a href={a.url} class="btn btn-primary w-full" target="_blank" rel="noopener">
                Start activity <span aria-hidden="true">→</span><span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
      <div class="cta-strip mt-10">
        <p>Ready for full access to a level?</p>
        <a href="/pricing/" class="btn btn-secondary">See pricing</a>
      </div>
    </div>
  </section>

  <!-- Video -->
  <section id="intro-video" class="section bg-mist scroll-mt-32" aria-labelledby="video-title">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 id="video-title" class="h-section">A three-minute intro to Barakhadi</h2>
        <p class="lede mt-4">See how kids move through activities, hear native Marathi audio and track their progress level by level.</p>
      </div>
      <WistiaVideo id={videos.homeDemo} title="Barakhadi promo video" />
    </div>
  </section>

  <!-- Made by teachers -->
  <section class="section" aria-labelledby="team-title">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1fr_1.2fr]">
      <ul class="team-card">
        <li>
          <span class="team-initial" aria-hidden="true">D</span>
          <div>
            <p class="team-name">Deepti Pandit</p>
            <p class="team-role">Marathi teacher for 20+ years, elementary teacher for 15</p>
          </div>
        </li>
        <li>
          <span class="team-initial alt" aria-hidden="true">P</span>
          <div>
            <p class="team-name">Pushkar Damle</p>
            <p class="team-role">Product and analytics, 22 years</p>
          </div>
        </li>
      </ul>
      <div>
        <h2 id="team-title" class="h-section">Created by teachers and product designers</h2>
        <div class="mt-5 grid gap-4 text-ink-soft">
          <p>Barakhadi was born from a simple goal: help families keep their Marathi heritage alive.</p>
          <p>
            Experienced Marathi teachers and education technology experts built it together, combining proven language-teaching methods with modern interactive tools. Whether your child is learning their first Devanagari letters or preparing for a biliteracy exam, Barakhadi makes Marathi accessible and fun.
          </p>
          <p>Language isn't just words. It's culture, stories and connection between generations.</p>
        </div>
        <a href="/about/" class="btn btn-secondary mt-7">Read our story</a>
      </div>
    </div>
  </section>

  <!-- Schools -->
  <section class="schools" aria-labelledby="schools-title">
    <div class="container-site schools-inner">
      <div>
        <h2 id="schools-title" class="text-3xl md:text-4xl">Teaching a Marathi class?</h2>
        <p class="mt-3 max-w-2xl text-lg">
          Marathi shalas use Barakhadi for their classes. Each class gets its own private space where teachers set assignments, grade them and follow every student's progress.
        </p>
      </div>
      <a href="/who-its-for/#schools" class="btn btn-light shrink-0">Barakhadi for schools</a>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="final-cta" aria-labelledby="final-title">
    <div class="container-site text-center">
      <h2 id="final-title" class="h-section text-white">Ready to start your Marathi journey?</h2>
      <p lang="mr" class="final-marathi mt-2">{site.taglineMarathi}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#try-free" class="btn btn-primary">Try free activities</a>
        <a href="/contact-us/" class="btn btn-outline-light">Contact us</a>
      </div>
      <p class="mt-6 text-white/90">Questions? <a href="/faq/" class="font-bold text-white">Read the FAQ</a></p>
    </div>
  </section>
</Base>

<style>
  /* Badges: four tilted cards in the logo colours */
  .badges {
    margin-top: 4.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    max-width: 52rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) { .badges { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; } }
  .badge {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.15rem;
    padding: 1.4rem 0.9rem;
    border: 3px solid var(--tone);
    border-radius: 1rem;
    background: var(--tone-soft);
    box-shadow: 0 4px 15px rgb(0 0 0 / 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .badge:nth-child(1) { rotate: -3deg; }
  .badge:nth-child(2) { rotate: 2deg; }
  .badge:nth-child(3) { rotate: -2deg; }
  .badge:nth-child(4) { rotate: 3deg; }
  .badge:hover { transform: scale(1.05); box-shadow: 0 10px 28px rgb(0 0 0 / 0.12); }
  .badge-orange { --tone: var(--color-orange); --tone-soft: var(--color-orange-soft); --tone-ink: var(--color-orange-ink); }
  .badge-green { --tone: var(--color-green); --tone-soft: var(--color-green-soft); --tone-ink: var(--color-green-ink); }
  .badge-blue { --tone: var(--color-blue); --tone-soft: var(--color-blue-soft); --tone-ink: var(--color-blue); }
  .badge-red { --tone: var(--color-red); --tone-soft: var(--color-red-soft); --tone-ink: var(--color-red-ink); }
  .badge-value { font-family: var(--font-display); font-size: 2.1rem; font-weight: 800; line-height: 1.1; color: var(--tone-ink); }
  .badge-label { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; }
  .badge-detail { margin-top: 0.35rem; font-size: 0.9rem; line-height: 1.35; color: var(--color-ink-soft); }

  /* Skills */
  .skill { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 968px) {
    .skill { grid-template-columns: 1fr 1fr; gap: 4.5rem; }
    .skill.reverse .skill-text { order: 2; }
  }
  .skill-text { text-align: center; }
  @media (min-width: 968px) { .skill-text { text-align: left; } }
  .skill-num {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    background: var(--color-green);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
  }
  .skill:nth-child(1) .skill-num { background: var(--color-red); }
  .skill:nth-child(2) .skill-num { background: var(--color-blue); }
  .skill:nth-child(3) .skill-num { background: var(--color-green); }
  .skill h3 { margin-top: 1.1rem; font-size: clamp(1.8rem, 3vw, 2.2rem); }
  .skill p { margin-top: 0.75rem; margin-bottom: 1.6rem; color: var(--color-ink-soft); font-size: 1.1rem; }
  .skill-shot {
    padding: 6px;
    background: #fff;
    border-radius: var(--radius-card);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.14);
    rotate: 1.5deg;
  }
  .skill.reverse .skill-shot { rotate: -1.5deg; }
  .skill-shot img { border-radius: 0.9rem; width: 100%; }

  /* Benefits */
  .benefit-icon {
    display: inline-grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    background: var(--color-green);
    color: #fff;
  }
  li:nth-child(1) > .benefit-icon { background: var(--color-red); }
  li:nth-child(2) > .benefit-icon { background: var(--color-blue); }

  /* Free activity cards */
  .activity-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 3px solid var(--color-line);
    border-radius: var(--radius-card);
    background: #fff;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .activity-card:hover { transform: translateY(-6px); border-color: var(--color-orange); box-shadow: 0 14px 32px rgb(0 0 0 / 0.1); }
  .activity-thumb {
    display: grid;
    place-items: center;
    height: 11rem;
    color: #fff;
    font-size: 4.2rem;
    font-weight: 800;
    line-height: 1;
  }
  .tone-green { background: linear-gradient(135deg, #22b45c, var(--color-green-dark)); }
  .tone-blue { background: linear-gradient(135deg, #2a8fd6, #0a5a93); }
  .tone-red { background: linear-gradient(135deg, #e5594e, #a8281f); }
  .cta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.5rem;
    padding: 1.6rem;
    border-radius: var(--radius-card);
    background: var(--color-mist);
    text-align: center;
    font-weight: 700;
    font-size: 1.15rem;
  }

  /* Team */
  .team-card {
    display: grid;
    gap: 1.4rem;
    padding: 2rem;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--color-green), var(--color-green-dark));
    color: #fff;
    box-shadow: 0 18px 40px rgb(17 155 73 / 0.25);
  }
  .team-card li { display: flex; gap: 1rem; align-items: center; }
  .team-initial {
    flex: none;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: #fff;
    color: var(--color-green-ink);
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
  }
  .team-initial.alt { background: var(--color-blue); color: #fff; }
  .team-name { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; }
  .team-role { opacity: 0.92; }

  /* Schools band */
  .schools { background: linear-gradient(135deg, #cf4035, #b3261e); color: #fff; }
  .schools-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-block: 3rem;
  }
  .schools .btn-light { color: var(--color-red-ink); }

  /* Final CTA */
  .final-cta {
    background: linear-gradient(135deg, var(--color-blue), #0a5a93);
    color: #fff;
    padding-block: 5rem;
  }
  .final-marathi { font-size: 1.6rem; font-weight: 800; color: #ffd8a8; }
</style>
