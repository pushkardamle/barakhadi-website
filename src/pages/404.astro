---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="container-site text-center">
      <p lang="mr" class="text-7xl font-extrabold text-orange">अरेरे!</p>
      <h1 class="mt-4 text-4xl md:text-5xl">We couldn't find that page</h1>
      <p class="lede mx-auto mt-4 max-w-xl">It may have moved when we rebuilt the site. Try one of these instead.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary">Go to the home page</a>
        <a href="/faq/" class="btn btn-secondary">Read the FAQ</a>
        <a href="/contact-us/" class="btn btn-secondary">Contact us</a>
      </div>
    </div>
  </section>
</Base>
