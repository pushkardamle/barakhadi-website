---
import { Image } from 'astro:assets';
import { site } from '@/data/site';
import clock from '@/assets/activities/ss_clock_result.avif';
import numbers from '@/assets/activities/ss_numbers_51_60_result.avif';
import crossword from '@/assets/activities/ss_crossword_result.avif';
import dots from '@/assets/activities/ss_numbers_join_the_dots_result.avif';
import prepositions from '@/assets/activities/ss_prepositions_result.avif';
import sequence from '@/assets/activities/ss_clock_2_result.avif';

// Three columns of activity screenshots, tilted like cards on a table.
// (The three core-skills images on the home page are different ones, so nothing repeats.)
const columns = [
  [
    { src: clock, alt: 'Conversation activity: a family talking at the dinner table' },
    { src: numbers, alt: 'Listening activity: putting the numbers 51 to 60 in order' },
  ],
  [
    { src: crossword, alt: 'Picture crossword activity with a Marathi letter bank', featured: true },
    { src: prepositions, alt: 'Listening activity about prepositions' },
  ],
  [
    { src: dots, alt: 'Join-the-dots activity with Marathi numbers' },
    { src: sequence, alt: 'Listening activity: arranging picture cards in order' },
  ],
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-site hero-grid">
    <div class="hero-text">
      <h1 id="hero-title">
        Learn Marathi the <span class="fun"><span>F</span><span>u</span><span>n</span></span> Way
      </h1>
      <p class="hero-marathi" lang="mr">{site.taglineMarathi}</p>
      <p class="hero-sub">An interactive way for kids to learn to read, write and speak Marathi.</p>
      <div class="hero-cta">
        <a href="#try-free" class="btn btn-primary" data-track="cta_clicked" data-track-cta="hero_try_free">Try free activities</a>
        <a href="/contact-us/" class="btn btn-secondary" data-track="cta_clicked" data-track-cta="hero_contact">Contact us</a>
      </div>
    </div>

    <div class="photo-strip">
      {columns.map((col, i) => (
        <div class={`photo-col photo-col-${i + 1}`}>
          {col.map((photo) => (
            <figure class:list={['photo-card', { featured: photo.featured }]}>
              <Image src={photo.src} alt={photo.alt} widths={[320, 640]} sizes="(min-width: 968px) 300px, 45vw" loading="eager" />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
    color: var(--hero-ink);
    padding-block: 5rem 0;
  }
  /* The knot from the logo, faint in two corners */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    background: url('/icon-512.png') no-repeat center / contain;
    pointer-events: none;
  }
  .hero::before { width: 46rem; height: 46rem; top: -18rem; right: -24rem; opacity: 0.12; rotate: 15deg; }
  .hero::after { width: 34rem; height: 34rem; bottom: -15rem; left: -18rem; opacity: 0.08; rotate: -20deg; }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
  }
  .hero-text { text-align: center; max-width: 34rem; margin-inline: auto; }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.1rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: #0b3d20; /* deep warm green instead of flat black */
  }
  /* "Fun" as a tilted white sticker, each letter in a logo colour (like the बाराखडी wordmark).
     On page load it swings once like a hanging door sign, then settles at its tilt. */
  .fun {
    display: inline-block;
    padding: 0 0.22em 0.04em;
    margin-inline: 0.06em;
    border-radius: 0.28em;
    background: #fff;
    rotate: -4deg;
    letter-spacing: 0.03em;
    transform-origin: 50% -0.15em;
    animation: sign-swing 1.52s cubic-bezier(0.34, 0.1, 0.25, 1) 0.4s both;
  }
  @keyframes sign-swing {
    0% { rotate: -4deg; }
    14% { rotate: 13deg; }
    30% { rotate: -14deg; }
    46% { rotate: 8deg; }
    62% { rotate: -9deg; }
    78% { rotate: 1deg; }
    90% { rotate: -5deg; }
    100% { rotate: -4deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fun { animation: none; }
  }
  .fun span:nth-child(1) { color: var(--color-red); }
  .fun span:nth-child(2) { color: var(--color-blue); }
  .fun span:nth-child(3) { color: var(--color-green); }
  .hero-marathi {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 5.4vw, 3rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-orange);
    -webkit-text-stroke: 0;
    text-shadow:
      -1.5px -1.5px 0 #4a2c0a, 1.5px -1.5px 0 #4a2c0a, -1.5px 1.5px 0 #4a2c0a, 1.5px 1.5px 0 #4a2c0a,
      -1.5px 0 0 #4a2c0a, 1.5px 0 0 #4a2c0a, 0 -1.5px 0 #4a2c0a, 0 1.5px 0 #4a2c0a;
  }
  .hero-sub {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
  }
  .hero-cta {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
  }

  /* Phone/tablet: screenshots sit below the text, cropped at the bottom edge */
  .photo-strip {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    rotate: 6deg;
    margin-inline: -2rem;
    margin-top: 1.5rem;
    margin-bottom: -2rem;
    padding-bottom: 1rem;
  }
  .photo-col { display: flex; flex-direction: column; gap: 0.9rem; }
  .photo-col-2 { margin-top: 2rem; }
  .photo-col-3 { margin-top: -1rem; }
  .photo-card {
    width: min(44vw, 15rem);
    aspect-ratio: 4 / 3;
    padding: 4px;
    background: #fff;
    border-radius: 0.6rem;
    box-shadow: 0 8px 26px rgb(0 0 0 / 0.16);
  }
  .photo-card img { width: 100%; height: 100%; object-fit: cover; border-radius: 0.4rem; }
  .photo-card.featured { box-shadow: 0 14px 44px rgb(0 0 0 / 0.26); }
  .photo-col-3 { display: none; }

  @media (min-width: 640px) {
    .photo-col-3 { display: flex; }
    .photo-card { width: min(30vw, 15rem); }
  }

  @media (min-width: 968px) {
    /* Generous space above and below the tilted screenshots so they don't touch the hero edges */
    .hero { padding-block: 11rem 10.5rem; }
    .hero-grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: 2rem; }
    .hero-text { text-align: left; margin-inline: 0; }
    .hero-cta { justify-content: flex-start; }
    .photo-strip {
      justify-content: flex-start;
      rotate: 8deg;
      margin: 0 -14rem 0 0;
      padding: 0;
      gap: 1.4rem;
    }
    .photo-col { gap: 1.6rem; }
    .photo-col-2 { margin-top: 3rem; }
    .photo-col-3 { margin-top: -2rem; }
    .photo-card { width: 17.5rem; }
  }
</style>
