---
// Click-to-play Wistia video. Shows the poster image (fetched from Wistia's oEmbed API at build time)
// and loads the Wistia player only when the visitor presses play, so pages stay fast.
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;

let poster: string | undefined;
let duration: string | undefined;
try {
  const res = await fetch(`https://fast.wistia.com/oembed?url=${encodeURIComponent(`https://home.wistia.com/medias/${id}`)}`);
  if (res.ok) {
    const data = (await res.json()) as { thumbnail_url?: string; duration?: number };
    poster = data.thumbnail_url?.replace(/image_crop_resized=\d+x\d+/, 'image_crop_resized=1280x720');
    if (data.duration) {
      const total = Math.round(data.duration);
      const h = Math.floor(total / 3600);
      const m = Math.floor((total % 3600) / 60);
      const s = total % 60;
      duration = h ? `${h} hr ${m} min` : m >= 10 ? `${m} min` : `${m}:${String(s).padStart(2, '0')}`;
    }
  }
} catch {
  // Offline build: fall back to the branded placeholder below.
}
---

<div class:list={['wistia', className]} data-wistia-id={id} data-title={title}>
  <button type="button" class="wistia-play" aria-label={`Play video: ${title}`} data-track="video_played" data-track-video={title}>
    {poster ? <img src={poster} alt="" loading="lazy" decoding="async" width="1280" height="720" /> : <span class="wistia-fallback" aria-hidden="true" />}
    <span class="wistia-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="34" height="34"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </span>
    {duration && <span class="wistia-duration">{duration}</span>}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.wistia').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://fast.wistia.net/embed/iframe/${box.dataset.wistiaId}?autoPlay=true&playerColor=119b49`;
      iframe.title = box.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .wistia {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-green-dark);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.18);
  }
  .wistia :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .wistia-play { position: absolute; inset: 0; width: 100%; height: 100%; cursor: pointer; display: block; }
  .wistia-play img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .wistia-play:hover img { transform: scale(1.03); }
  .wistia-fallback { position: absolute; inset: 0; background: linear-gradient(135deg, var(--color-green), var(--color-green-dark)); }
  .wistia-icon {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    padding-left: 0.3rem;
    border-radius: 50%;
    background: var(--color-orange);
    color: #2a1600;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .wistia-play:hover .wistia-icon { transform: scale(1.08); background: var(--color-orange-dark); }
  .wistia-duration {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgb(0 0 0 / 0.7);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
  }
</style>
